# Conexión a la base (desarrollo local con SQLite: sqlite:///./foodstore.db)
DATABASE_URL=postgresql://user:pass@localhost:5432/foodstore_db

# Firma del JWT: mínimo 32 caracteres
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256

# Expiración de la cookie y del token (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen permitido en CORS
FRONTEND_ORIGIN=http://localhost:5173
